{
  "name": "polysignal",
  "version": "0.1.0",
  "description": "Evidence-first Polymarket market-microstructure research and shadow execution system.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20 <23",
    "pnpm": ">=9 <10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skishore23/polysignal.git"
  },
  "homepage": "https://github.com/skishore23/polysignal#readme",
  "bugs": {
    "url": "https://github.com/skishore23/polysignal/issues"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "migrate": "npx tsx scripts/migrate.ts",
    "dev": "npm run migrate && (lsof -ti:3001 | xargs kill -9) 2>/dev/null || true && concurrently --kill-others-on-fail \"npm:dev --workspace apps/worker\" \"npm:dev --workspace apps/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier -w .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "math:golden": "vitest run tests/trading/math_golden.test.ts",
    "math:differential": "vitest run tests/trading/math_differential.test.ts",
    "math:properties": "vitest run tests/trading/math_properties.test.ts",
    "math:assurance": "vitest run tests/trading/math_golden.test.ts tests/trading/math_differential.test.ts tests/trading/math_properties.test.ts",
    "test:watch": "vitest",
    "test:validation": "vitest run --no-file-parallelism tests/truth tests/book tests/features tests/eval",
    "test:validation:pr": "vitest run --no-file-parallelism tests/truth tests/book tests/features tests/eval tests/markout-sign.test.ts",
    "test:unit": "vitest run \"packages/**/?(*.)test.ts\" \"apps/**/?(*.)test.ts\"",
    "test:integration": "vitest run tests/storage/migration_immutability.test.ts tests/ingestion/ingestion-market-scope.test.ts",
    "test:live": "RUN_LIVE_TESTS=1 vitest run \"tests/live/**/*.test.ts\"",
    "e2e": "playwright test",
    "dev:e2e": "npm run migrate && npm run dev --workspace apps/web",
    "monitor": "npx tsx scripts/monitor-profitability.ts",
    "monitor-maker-health": "npx tsx scripts/monitor-maker-health.ts",
    "debug:polymarket": "node scripts/debug-polymarket-connectivity.mjs",
    "debug:web-dev": "node scripts/debug-web-dev-exit.mjs",
    "verify": "npx tsx scripts/verify.ts",
    "verify:shadow": "npx tsx scripts/verify-shadow-execution.ts",
    "verify:baseline": "bash scripts/verify_baseline.sh",
    "go-live:gate": "npx tsx scripts/go-live-gate.ts",
    "evidence:pack": "npx tsx scripts/evidence-pack.ts",
    "evidence:pack:frozen": "npx tsx scripts/evidence-pack.ts --phase frozen",
    "money:loop": "npx tsx scripts/money-loop.ts",
    "money:loop:apply": "npx tsx scripts/money-loop.ts --apply-config=true",
    "money:loop:dry": "npx tsx scripts/money-loop.ts --apply-config=false",
    "verify:edge": "REPO_ROOT=\"$(pwd)\" npx tsx scripts/verify-edge-visibility.ts",
    "markov-canary": "npx tsx scripts/markov-canary.ts",
    "regime:audit": "npx tsx scripts/regime_audit.ts",
    "stall:audit": "npx tsx scripts/stall_audit.ts",
    "replay:tick": "npm run build --workspace apps/worker && node apps/worker/dist/tools/replayTick.js",
    "report:shadow": "npx tsx scripts/shadow-report.ts",
    "report:shadow-gap": "npx tsx scripts/shadow-gap-report.ts",
    "find-strategy": "npx tsx scripts/find-profitable-strategy.ts",
    "wallets:seed": "npx tsx scripts/seed-wallets.ts",
    "wallets:seed:reset": "npx tsx scripts/seed-wallets.ts --reset",
    "wallets:audit": "npx tsx scripts/seed-wallets.ts --audit-only",
    "wallets:list": "npx tsx scripts/list-wallets.ts",
    "counterfactual:gate": "npx tsx scripts/validate-counterfactual-gate.ts",
    "replay:policy": "npx tsx scripts/replay-queue-policy-scorer.ts",
    "analyze:imports": "npx tsx scripts/analyze_import_graph.ts",
    "deadcode:worker": "npx tsx scripts/find_unreachable.ts",
    "deadcode:worker:strict": "npx tsx scripts/find_unreachable.ts --strict",
    "deadcode:worker:allowlist": "npx tsx scripts/find_unreachable.ts --update-allowlist",
    "archive:scan": "npx tsx scripts/find_archive_candidates.ts",
    "db:auto-vacuum": "npx tsx scripts/ensure-incremental-auto-vacuum.ts",
    "db:hard-cutover-reset": "npx tsx scripts/archive/manual-diagnostics/hard-cutover-reset.ts --confirm"

  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^22.10.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "better-sqlite3": "^9.6.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.0.4",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.1.8",
    "ws": "^8.18.0"
  }
}
