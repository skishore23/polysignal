# Local runtime
DB_PATH=data/dev.db
EVENTS_PATH=data/events.jsonl
WORKER_PORT=3001
LOG_LEVEL=info
LOG_PRETTY=1
CLOB_EVENTS_SAMPLE_RATE=0

# Optional dashboard protection.
# When both values are set, the browser prompts for HTTP Basic authentication.
# In production without credentials, read-only pages remain public but mutating API
# requests are rejected.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Optional diagnostics
DEBUG_REACHABILITY=0
DEBUG_REACHABILITY_OUT=reports/refactor-baseline/runtime_reachability.json
REGIME_GATE_DEBUG_SAMPLE=0
